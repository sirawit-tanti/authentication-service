{
  "name": "authentication-service",
  "version": "1.0.0",
  "description": "Production-oriented authentication service built with Fastify and TypeScript",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "generate": "prisma generate",
    "build": "npm run generate && tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run generate && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:database": "cross-env RUN_DATABASE_TESTS=true vitest run tests/integration/repositories",
    "test:security": "vitest run tests/integration/security tests/integration/authentication/refresh.route.test.ts tests/integration/authentication/login-rate-limit.test.ts",
    "check:security": "npm run typecheck && npm run lint && npm run format:check && npm run test:security",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build --detach",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs --follow app",
    "docker:check": "docker compose exec app npm run check",
    "dev:worker:email": "tsx watch src/workers/email.worker.ts",
    "start:worker:email": "node dist/workers/email.worker.js",
    "dev:worker:outbox": "tsx watch src/workers/outbox.worker.ts",
    "start:worker:outbox": "node dist/workers/outbox.worker.js"
  },
  "keywords": [
    "authentication",
    "fastify",
    "typescript",
    "clean-architecture"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.2",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
