generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("session_status")
}

enum AuditOutcome {
  SUCCESS
  FAILURE

  @@map("audit_outcome")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("api_key_status")
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
  GITHUB
  CUSTOM

  @@map("oauth_provider")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email           String @db.VarChar(320)
  normalizedEmail String @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(320)
  passwordHash    String @map("password_hash") @db.VarChar(255)

  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean    @default(false) @map("email_verified")

  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)

  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)

  version Int @default(1)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  profile                 UserProfile?
  userRoles               UserRole[]
  sessions                Session[]
  devices                 Device[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  apiKeys                 ApiKey[]
  oauthAccounts           OAuthAccount[]

  @@index([status], map: "users_status_idx")
  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model UserProfile {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique(map: "user_profiles_user_id_key") @map("user_id") @db.Uuid

  firstName   String? @map("first_name") @db.VarChar(100)
  lastName    String? @map("last_name") @db.VarChar(100)
  displayName String? @map("display_name") @db.VarChar(150)
  phoneNumber String? @map("phone_number") @db.VarChar(30)
  locale      String  @default("th-TH") @db.VarChar(20)
  timezone    String  @default("Asia/Bangkok") @db.VarChar(50)

  avatarUrl String? @map("avatar_url") @db.VarChar(2048)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Application {
  id String @id @default(uuid()) @db.Uuid

  code        String  @unique(map: "applications_code_key") @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles        Role[]
  permissions  Permission[]
  sessions     Session[]
  apiKeys      ApiKey[]
  oauthClients OAuthClient[]

  @@index([isActive], map: "applications_is_active_idx")
  @@map("applications")
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @map("application_id") @db.Uuid

  code        String  @db.VarChar(100)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  isSystem    Boolean @default(false) @map("is_system")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([applicationId, code], map: "roles_application_id_code_key")
  @@index([applicationId, isActive], map: "roles_application_active_idx")
  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @map("application_id") @db.Uuid

  code        String  @db.VarChar(150)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(500)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(100)
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([applicationId, code], map: "permissions_application_id_code_key")
  @@index([applicationId, resource, action], map: "permissions_resource_action_idx")
  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  assignedById String?   @map("assigned_by_id") @db.Uuid
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "user_roles_user_id_role_id_key")
  @@index([userId], map: "user_roles_user_id_idx")
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([expiresAt], map: "user_roles_expires_at_idx")
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid

  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "role_permissions_role_id_permission_id_key")
  @@index([roleId], map: "role_permissions_role_id_idx")
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model Device {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  fingerprintHash String  @map("fingerprint_hash") @db.VarChar(255)
  deviceName      String? @map("device_name") @db.VarChar(150)
  deviceType      String? @map("device_type") @db.VarChar(50)
  operatingSystem String? @map("operating_system") @db.VarChar(100)
  browser         String? @db.VarChar(100)

  trusted    Boolean   @default(false)
  trustedAt  DateTime? @map("trusted_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, fingerprintHash], map: "devices_user_id_fingerprint_hash_key")
  @@index([userId, lastSeenAt], map: "devices_user_last_seen_idx")
  @@map("devices")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId        String  @map("user_id") @db.Uuid
  applicationId String  @map("application_id") @db.Uuid
  deviceId      String? @map("device_id") @db.Uuid

  status SessionStatus @default(ACTIVE)

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.Text

  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason   String?   @map("revoke_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, status], map: "sessions_user_status_idx")
  @@index([applicationId, status], map: "sessions_application_status_idx")
  @@index([expiresAt], map: "sessions_expires_at_idx")
  @@index([deviceId], map: "sessions_device_id_idx")
  @@map("sessions")
}

model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  sessionId String @map("session_id") @db.Uuid
  familyId  String @map("family_id") @db.Uuid

  tokenHash String @unique(map: "refresh_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)
  jti       String @unique(map: "refresh_tokens_jti_key") @db.Uuid

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  replacedByTokenId String? @unique(map: "refresh_tokens_replaced_by_token_id_key") @map("replaced_by_token_id") @db.Uuid
  revokeReason      String? @map("revoke_reason") @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedByToken RefreshToken? @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replacesToken   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId], map: "refresh_tokens_session_id_idx")
  @@index([familyId], map: "refresh_tokens_family_id_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "email_verification_tokens_user_id_idx")
  @@index([expiresAt], map: "email_verification_tokens_expires_at_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  tokenHash String @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model TokenBlacklist {
  id String @id @default(uuid()) @db.Uuid

  jti       String   @unique(map: "token_blacklist_jti_key") @db.Uuid
  tokenType String   @map("token_type") @db.VarChar(30)
  reason    String?  @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt], map: "token_blacklist_expires_at_idx")
  @@map("token_blacklist")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorUserId String? @map("actor_user_id") @db.Uuid

  action       String       @db.VarChar(150)
  resourceType String?      @map("resource_type") @db.VarChar(100)
  resourceId   String?      @map("resource_id") @db.VarChar(100)
  outcome      AuditOutcome

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.Text
  requestId String? @map("request_id") @db.VarChar(100)

  metadata     Json?
  errorMessage String? @map("error_message") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@map("audit_logs")
}

model ApiKey {
  id String @id @default(uuid()) @db.Uuid

  applicationId String  @map("application_id") @db.Uuid
  ownerUserId   String? @map("owner_user_id") @db.Uuid

  name       String       @db.VarChar(150)
  keyPrefix  String       @map("key_prefix") @db.VarChar(20)
  keyHash    String       @unique(map: "api_keys_key_hash_key") @map("key_hash") @db.VarChar(255)
  status     ApiKeyStatus @default(ACTIVE)
  scopes     String[]
  lastUsedAt DateTime?    @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ownerUser   User?       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, status], map: "api_keys_application_status_idx")
  @@index([keyPrefix], map: "api_keys_key_prefix_idx")
  @@index([expiresAt], map: "api_keys_expires_at_idx")
  @@map("api_keys")
}

model OAuthClient {
  id String @id @default(uuid()) @db.Uuid

  applicationId String @map("application_id") @db.Uuid

  clientId         String   @unique(map: "oauth_clients_client_id_key") @map("client_id") @db.VarChar(100)
  clientSecretHash String   @map("client_secret_hash") @db.VarChar(255)
  name             String   @db.VarChar(150)
  redirectUris     String[] @map("redirect_uris")
  allowedScopes    String[] @map("allowed_scopes")
  isActive         Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, isActive], map: "oauth_clients_application_active_idx")
  @@map("oauth_clients")
}

model OAuthAccount {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)

  accessTokenEncrypted  String?   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime? @map("token_expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], map: "oauth_accounts_provider_account_id_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model OutboxMessage {
  id          String       @id @db.Uuid
  topic       String       @db.VarChar(100)
  eventType   String       @map("event_type") @db.VarChar(100)
  aggregateId String?      @map("aggregate_id") @db.Uuid
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at")
  lockedAt    DateTime?    @map("locked_at")
  lockedBy    String?      @map("locked_by") @db.VarChar(150)
  publishedAt DateTime?    @map("published_at")
  lastError   String?      @map("last_error") @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([status, availableAt, createdAt])
  @@index([lockedAt])
  @@map("outbox_messages")
}
