# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=authentication-service
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=authentication
POSTGRES_USER=authentication_user
POSTGRES_PASSWORD=change-this-local-database-password

# Used when the application runs directly on the host machine.
DATABASE_URL=postgresql://authentication_user:change-this-local-database-password@localhost:5432/authentication?schema=public

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-this-local-redis-password

# Used when the application runs directly on the host machine.
REDIS_URL=redis://:change-this-local-redis-password@localhost:6379/0

REDIS_KEY_PREFIX=auth:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=3

# -----------------------------------------------------------------------------
# Password hashing
# -----------------------------------------------------------------------------
BCRYPT_COST=12

# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
BULLMQ_PREFIX=auth-queue
EMAIL_QUEUE_NAME=authentication-email
EMAIL_WORKER_CONCURRENCY=5
EMAIL_JOB_ATTEMPTS=5
EMAIL_JOB_BACKOFF_MS=5000

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=development
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Authentication Service
# Local development may use HTTP and localhost.
# Production must use a public HTTPS URL.
EMAIL_VERIFICATION_BASE_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=10

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15

# Development placeholder only.
# Production must use a unique random value of at least 32 characters.
# Do not use values containing change-this, development-only, example-secret,
# default-secret, replace-me, or your-secret.
JWT_ACCESS_TOKEN_SECRET=development-only-change-this-secret
JWT_ACCESS_TOKEN_ISSUER=authentication-service
JWT_ACCESS_TOKEN_AUDIENCE=internal-applications
JWT_ACCESS_TOKEN_TTL_MINUTES=15

REFRESH_TOKEN_TTL_DAYS=30

AUTH_RATE_LIMIT_LOGIN_MAX=5
AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=60000

AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REGISTER_WINDOW_MS=3600000

AUTH_RATE_LIMIT_EMAIL_MAX=3
AUTH_RATE_LIMIT_EMAIL_WINDOW_MS=900000

AUTH_RATE_LIMIT_PASSWORD_MAX=5
AUTH_RATE_LIMIT_PASSWORD_WINDOW_MS=900000

AUTH_RATE_LIMIT_REFRESH_MAX=20
AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=60000

HTTP_BODY_LIMIT_BYTES=65536

# Comma-separated browser origins without paths, queries, or fragments.
# Production origins must use HTTPS.
# Wildcard origins are not allowed in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Wildcard origins must never be combined with credentials.
CORS_ALLOW_CREDENTIALS=false

HTTP_HSTS_MAX_AGE_SECONDS=31536000

# Number of trusted reverse-proxy hops.
# Local direct access: 0
# One Nginx/load balancer in front of the API: 1
HTTP_TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Metrics
# -----------------------------------------------------------------------------
# Optional during local development.
# Production denies /metrics unless a token is configured.
# Use a random value containing at least 32 characters.
METRICS_BEARER_TOKEN=9bb1d182c0271d7d57864f8b03239379e162fbb8627e37bad119118427125c33